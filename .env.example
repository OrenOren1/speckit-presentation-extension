# speckit-presentation-extension — environment template
#
# Copy this to `.env` (which is gitignored) and fill in the keys you have.
# The extension reads these in priority order; missing keys are fine — it
# falls back to prompts-only mode.
#
# All keys can ALSO live in per-file form (one key per line):
#   .googleAI-token         # Gemini, multi-key supported
#   .gemini-api-key         # Gemini, multi-key supported
#   .imgbb-token            # ImgBB, single key

# ----- LLM / image-generation providers (need at least ONE) -----

# Gemini (Nano Banana / Nano Banana Pro) — preferred provider
GEMINI_API_KEY=
# Multi-key form (comma- or newline-separated). The script rotates keys on 429/401/403.
# GEMINI_API_KEYS=

# OpenAI DALL-E 3 — fallback provider
OPENAI_API_KEY=

# ----- Image storage (optional) -----

# ImgBB — when set, generated images are also uploaded and slides.md uses the remote URL.
# When absent, slides.md uses local relative paths under presentation/assets/images/.
IMGBB_API_KEY=

# ----- Provider overrides (optional) -----

# Force a specific provider regardless of which keys are present.
# IMAGE_GEN_PROVIDER=gemini   # or "openai"

# Force a specific model.
# IMAGE_GEN_MODEL=gemini-2.5-flash-image   # or "gemini-2.5-pro-image", "dall-e-3"
